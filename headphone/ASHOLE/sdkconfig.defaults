CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_PAN_ENABLED=y
CONFIG_BT_BLE_ENABLED=n

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Set this to Settings > General > About > Name on the iPhone.
CONFIG_PAN_PEER_DEVICE_NAME="section"
CONFIG_PAN_LOCAL_DEVICE_NAME="ESP32_PANU"
CONFIG_PAN_PING_TARGET="8.8.8.8"
CONFIG_PAN_PING_TARGET_IPV6="2606:4700:f1::123"
CONFIG_PAN_PING_COUNT=5
CONFIG_PAN_PING_TIMEOUT_MS=3000
CONFIG_PAN_RETRY_DELAY_SECONDS=15
CONFIG_PAN_DHCP_TIMEOUT_SECONDS=30
# CONFIG_PAN_STATIC_IPV4_FALLBACK is not set
CONFIG_PAN_STATIC_IPV4_ADDRESS="172.20.10.2"
CONFIG_PAN_STATIC_IPV4_GATEWAY="172.20.10.1"
CONFIG_PAN_STATIC_IPV4_NETMASK="255.255.255.240"
CONFIG_PAN_NETWORK_TEST_INTERVAL_SECONDS=30
CONFIG_PAN_HTTP_GET_URL="http://httpbin.org/get"
CONFIG_PAN_HTTP_POST_URL="http://httpbin.org/post"
CONFIG_PAN_HTTP_TIMEOUT_MS=10000
CONFIG_PAN_IPV4_DNS_SERVER="1.1.1.1"
CONFIG_PAN_SNTP_SERVER="2606:4700:f1::123"
CONFIG_PAN_IPV6_DNS_SERVER="2400:3200::1"
CONFIG_PAN_TIME_ZONE="CST-8"
CONFIG_PAN_TIME_PRINT_INTERVAL_SECONDS=30

# iPhone PAN may provide IPv6 SLAAC/RDNSS without an IPv4 DHCP lease.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_RDNSS_MAX_DNS_SERVERS=2
